{
  "manifest_version": 3,
  "name": "Drive Path Copier TEST",
  "version": "1.0",
  "description": "Copy Google Drive file path and share links with custom formatting options.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "activeTab",
    "clipboardWrite",
    "scripting",
    "storage"
  ],

  "host_permissions": [
    "https://drive.google.com/*"
  ],

  "background": {
    "service_worker": "scripts/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://drive.google.com/*"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_idle"
    }
  ],

  "commands": {
    "copy-path-shortcut": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Copy full Google Drive path to clipboard"
    }
  }
}
